# 乐聊 / ChatPlusAI
LIAOLIAO_LOGIN_URL=https://mai.zhisuitech.com/#/login
LIAOLIAO_WORKBENCH_URL=https://mai.zhisuitech.com/#/workbench/conversation
LIAOLIAO_ACCOUNT=
LIAOLIAO_PASSWORD=
# `chrome` uses the installed Google Chrome. Leave empty or use `chromium` for Playwright Chromium.
# Do not point Playwright at the user's default Chrome profile; Session is stored only at LIAOLIAO_SESSION_PATH.
LIAOLIAO_BROWSER_CHANNEL=chrome
LIAOLIAO_HEADLESS=true
LIAOLIAO_LOGIN_TIMEOUT_SECONDS=300
LIAOLIAO_COLLECTION_LIMIT=100
LIAOLIAO_MAX_SCROLL_PAGES=20
LIAOLIAO_SETTLE_MILLISECONDS=2500

# OpenAI-compatible LLM。留空时会复用仓库根目录已有的 DEEPSEEK_* 配置。
LIAOLIAO_LLM_BASE_URL=
LIAOLIAO_LLM_API_KEY=
LIAOLIAO_LLM_MODEL=
LIAOLIAO_LLM_REVIEW_MODEL=
LIAOLIAO_LLM_TIMEOUT_SECONDS=60
LIAOLIAO_QUALITY_REVIEW_ENABLED=true
LIAOLIAO_MAX_HISTORY_MESSAGES=12

# 第一阶段默认关闭所有程序化发送；客服在乐聊输入框内自行确认并发送。
# 旧本地审核页的显式发送兼容能力也保持关闭。
LIAOLIAO_HUMAN_SEND_ENABLED=false

# 本地Web工作台
LIAOLIAO_WEB_HOST=127.0.0.1
LIAOLIAO_WEB_PORT=8876
LIAOLIAO_AUTO_COLLECT_SECONDS=0

# 可选：启用 Commerce Ops 中央模式。
# 四项同时配置后，节点会上报消息/右侧面板并消费只填入不发送的 FILL_DRAFT 命令；
# 浏览器 Session 和登录密码始终只保存在本机。
COMMERCE_OPS_API_URL=http://127.0.0.1:3101
LIAOLIAO_CENTRAL_ACCOUNT_ID=
LIAOLIAO_WORKER_ID=customer-service-pc-01
CUSTOMER_SERVICE_WORKER_TOKEN=
LIAOLIAO_CENTRAL_TIMEOUT_SECONDS=10

# 可选路径；相对路径相对于本项目目录
# LIAOLIAO_DATABASE_PATH=data/liaoliao.db
# LIAOLIAO_SESSION_PATH=runtime/browser/storage-state.json
# LIAOLIAO_SELECTORS_PATH=selectors.json
# LIAOLIAO_KNOWLEDGE_DIR=knowledge
# LIAOLIAO_LOG_DIR=logs
