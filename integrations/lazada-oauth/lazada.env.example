# Lazada OAuth service. Copy these names into the repository-root, Git-ignored .env.
LAZADA_OAUTH_HOST=127.0.0.1
LAZADA_OAUTH_PORT=8977
LAZADA_APP_COUNT=3
LAZADA_DEFAULT_APP_ID=app-1

# App 1 retains the legacy names and callback route.
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_CALLBACK_URL=https://oauth.example.com/lazada/callback
LAZADA_APP_1_ID=app-1
LAZADA_APP_1_NAME=Lazada Stores 01-20
LAZADA_APP_1_CALLBACK_URL=https://oauth.example.com/lazada/callback

LAZADA_APP_2_ID=app-2
LAZADA_APP_2_NAME=Lazada Stores 21-40
LAZADA_APP_2_KEY=
LAZADA_APP_2_SECRET=
LAZADA_APP_2_CALLBACK_URL=https://oauth.example.com/lazada/apps/app-2/callback

LAZADA_APP_3_ID=app-3
LAZADA_APP_3_NAME=Lazada Stores 41-60
LAZADA_APP_3_KEY=
LAZADA_APP_3_SECRET=
LAZADA_APP_3_CALLBACK_URL=https://oauth.example.com/lazada/apps/app-3/callback

LAZADA_AUTH_BASE_URL=https://auth.lazada.com
LAZADA_API_BASE_URL=https://auth.lazada.com/rest
LAZADA_OAUTH_DB_PATH=storage/lazada-oauth.sqlite
LAZADA_OAUTH_STATE_TTL_SECONDS=900
LAZADA_API_TIMEOUT_MS=20000

# Generate locally. Never commit or share the real key or encrypted token database.
LAZADA_TOKEN_ENCRYPTION_KEY=
COMMERCE_CONNECTOR_DB_PATH=storage/lazada-oauth.sqlite
COMMERCE_CONNECTOR_ENCRYPTION_KEY=
COMMERCE_PLATFORM_REFRESH_SKEW_SECONDS=300
COMMERCE_PLATFORM_READ_RETRIES=2
COMMERCE_PLATFORM_WRITES_ENABLED=false

# Quick Tunnel values are local runtime state and must remain in .env/storage.
CLOUDFLARE_TUNNEL_MODE=quick
CLOUDFLARE_QUICK_TUNNEL_URL=
CLOUDFLARE_TUNNEL_NAME=commerce-ops-lazada-oauth
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_HOSTNAME=
CLOUDFLARE_TUNNEL_TOKEN=
