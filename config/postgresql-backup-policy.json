    "retentionDays": 7,
    "warningGiB": 50,
    "criticalGiB": 80,
    "monitorEveryMinutes": 15,
    "automaticDeletion": false,
    "requiresVerifiedBaseBackup": true,
    "requiresVerifiedRestoreTest": true,
    "requiresHumanConfirmation": true,
    "taskName": "CommerceOpsPostgreSQLWalMonitor"
  }
