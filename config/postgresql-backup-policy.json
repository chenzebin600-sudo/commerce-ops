{
  "contract": "COMMERCE-OPS-POSTGRESQL-BACKUP-1.0.0",
  "status": "ACTIVE",
  "productionCandidate": "commerce_ops",
  "rehearsalSource": "commerce_ops_staging",
  "logicalFormat": "pg_dump custom zstd:6",
  "encryptionEnabled": true,
  "encryption": "AES-256-GCM envelope",
  "keyStorage": "separate ACL-protected operating-system directory",
  "retentionDays": 30,
  "recoveryPointObjectiveMinutes": 15,
