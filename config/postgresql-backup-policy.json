  "owner": "Commerce Ops infrastructure operator",
  "backupCommand": "npm run postgres:production:backup -- --apply --database=commerce_ops --confirm-database=commerce_ops",
  "rehearsalCommand": "npm run postgres:production:backup -- --apply --database=commerce_ops_staging --confirm-database=commerce_ops_staging",
  "physicalBaseBackup": {
    "status": "ACTIVE",
    "root": "D:\\PostgreSQLBackups\\base_backup",
    "schedule": "weekly Sunday 03:00 Asia/Shanghai",
    "format": "tar",
    "compression": "client-zstd:6",
    "walMethod": "stream",
    "manifestChecksums": "SHA-256",
    "verification": "pg_verifybackup --no-parse-wal plus isolated restore start",
    "keepLatestVerified": 4,
    "automaticPrune": false,
    "deletionRequiresHumanConfirmation": true,
    "taskName": "CommerceOpsPostgreSQLBaseBackupWeekly"
