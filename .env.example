# Commerce Ops application. Keep loopback defaults for local-only access.
APP_HOST=127.0.0.1
APP_PORT=3101
APP_ACCESS_TOKEN=

# Audit logging. TRUST_PROXY accepts exact proxy IP addresses separated by commas.
# Leave TRUST_PROXY empty unless the application is actually behind those trusted proxies.
TRUST_PROXY=
AUDIT_RETENTION_DAYS=180

# Legacy names remain during the node B compatibility transition.
HOST=127.0.0.1
PORT=3101

DEEPSEEK_API_KEY=
CHROME_DEBUG_PORT=9222

# Comma-separated exact domains. Entries extend the built-in platform/CDN lists.
# Wildcards, IP addresses, bare TLDs and URLs are rejected at startup.
CHROME_ALLOWED_HOSTS=
IMAGE_PROXY_ALLOWED_HOSTS=
NETWORK_REQUEST_TIMEOUT_MS=20000
CHROME_MAX_REDIRECTS=5
IMAGE_PROXY_MAX_BYTES=10485760
IMAGE_PROXY_MAX_REDIRECTS=3

# Advertising service remains internal. AD_ANALYZER_PORT is retained as a legacy fallback.
AD_SERVICE_HOST=127.0.0.1
AD_SERVICE_PORT=4173
AD_SERVICE_BASE_URL=http://127.0.0.1:4173
AD_SERVICE_INTERNAL_TOKEN=
AD_SERVICE_INTERNAL_TOKEN_FILE=storage/.ad-service-internal-token
AD_ANALYZER_DIR=
AD_ANALYZER_PORT=4173

# Generate a strong random value and keep it outside Git. Do not reuse the access token.
APP_ENCRYPTION_KEY=

# File storage. Keep STORAGE_ROOT, UPLOAD_ROOT, EXPORT_ROOT and TEMP_ROOT on the same filesystem
# so successful temporary files can be moved atomically. EXPORT_STORAGE_PATH remains a fallback.
STORAGE_ROOT=storage
UPLOAD_ROOT=storage/uploads
EXPORT_ROOT=storage/exports/mabang
TEMP_ROOT=storage/temp
FILE_RETENTION_MANUAL_DAYS=30
FILE_RETENTION_SCHEDULED_DAYS=90
FILE_RETENTION_AD_SOURCE_DAYS=30
FILE_RETENTION_AD_OUTPUT_DAYS=90
FILE_RETENTION_REPORT_DAYS=90
FILE_RETENTION_FAILED_TEMP_HOURS=24
FILE_LIFECYCLE_RECENT_MINUTES=10
FILE_LIFECYCLE_MAX_FILES=10000
FILE_LIFECYCLE_TIMEOUT_SECONDS=60
FILE_LIFECYCLE_LEGACY_CUTOFF=2026-07-16T00:00:00+08:00
# Quarantine stays under STORAGE_ROOT. Permanent deletion is intentionally unavailable.
FILE_QUARANTINE_ROOT=quarantine
FILE_QUARANTINE_RETENTION_DAYS=30
FILE_DELETION_ENABLED=false
# Optional controlled advertising scan roots, resolved from AD_ANALYZER_DIR by default.
AD_LIFECYCLE_STORAGE_ROOT=
AD_LIFECYCLE_UPLOAD_ROOT=
AD_LIFECYCLE_TEMP_ROOT=
AD_LIFECYCLE_OUTPUT_ROOT=
MAX_UPLOAD_BYTES=20971520
TEMP_FILE_RETENTION_HOURS=24
MAX_WORKBOOK_SHEETS=50
MAX_WORKBOOK_ROWS=200000
MAX_WORKBOOK_COLUMNS=256
MAX_XLSX_ENTRIES=2000
MAX_XLSX_ENTRY_BYTES=67108864
MAX_XLSX_UNCOMPRESSED_BYTES=209715200
MAX_XLSX_COMPRESSION_RATIO=200
EXPORT_STORAGE_PATH=storage/exports/mabang

# Set only when this address is reachable from DingTalk clients.
APP_BASE_URL=

SCHEDULER_DB_PATH=storage/commerce-ops.sqlite
SCHEDULER_POLL_INTERVAL_MS=10000
SCHEDULER_CATCH_UP_THRESHOLD_MS=7200000
SCHEDULER_RETRY_DELAYS_MS=30000,120000,300000
