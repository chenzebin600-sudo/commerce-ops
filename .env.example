# Commerce Ops application. Keep loopback defaults for local-only access.
APP_HOST=127.0.0.1
APP_PORT=3101
APP_ACCESS_TOKEN=
# Explicitly opt in to LAN access without a login key. Keep false for safer deployments.
APP_ALLOW_UNAUTHENTICATED_LAN=false

# Audit logging. TRUST_PROXY accepts exact proxy IP addresses separated by commas.
# Leave TRUST_PROXY empty unless the application is actually behind those trusted proxies.
TRUST_PROXY=
AUDIT_RETENTION_DAYS=180

# Legacy names remain during the node B compatibility transition.
HOST=127.0.0.1
PORT=3101

DEEPSEEK_API_KEY=
# Optional DeepSeek-compatible endpoint. A bare base URL receives /chat/completions automatically.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Customer Service Reply Agent. It only creates suggestions and may fill the
# exact LiaoLiao editor through an authenticated edge worker; it never sends.
# Leave CUSTOMER_SERVICE_WORKER_TOKEN empty for local use: the server creates and
# reuses storage/secrets/customer-service-worker-token. Set the same explicit token
# only when securely pairing a separately deployed Edge worker.
# Keep STORAGE_ROOT on an access-controlled local disk; Windows relies on its ACL.
CUSTOMER_SERVICE_AI_ENABLED=false
CUSTOMER_SERVICE_DRAFT_FILL_ENABLED=false
CUSTOMER_SERVICE_MIN_AUTOFILL_CONFIDENCE=0.72
CUSTOMER_SERVICE_DEEPSEEK_MODEL=
CUSTOMER_SERVICE_AI_CONCURRENCY=4
CUSTOMER_SERVICE_AI_BATCH_SIZE=20
CUSTOMER_SERVICE_AI_POLL_MS=2000
CUSTOMER_SERVICE_CONTEXT_SETTLE_MS=8000
CUSTOMER_SERVICE_WORKER_TOKEN=
CUSTOMER_SERVICE_IDENTITY_PEPPER=
CUSTOMER_SERVICE_LOCAL_MAX_MONITORS=4
LIAOLIAO_PYTHON_VENV_DIR=.venv

# Shared Product Knowledge governance is fail-closed. Candidate imports remain
# unavailable to AI until a reviewer creates a draft Release and a different,
# allowlisted publisher explicitly publishes the reviewed digest.
PRODUCT_KNOWLEDGE_GOVERNANCE_ENABLED=false
PRODUCT_KNOWLEDGE_REVIEWER_IDS=
PRODUCT_KNOWLEDGE_PUBLISHER_IDS=

# Image generation is a separate provider from DeepSeek. DeepSeek only creates image plans/prompts.
# Leave these blank to keep prompt-only mode. Never expose these values to the browser.
IMAGE_AI_PROVIDER=
IMAGE_AI_API_KEY=
IMAGE_AI_BASE_URL=
IMAGE_AI_MODEL=
# Optional JSON override for the default 1 primary + 6 secondary image template.
IMAGE_AI_TEMPLATE_JSON=

# Configurable listing title limits. Values are guidance until live platform rules are connected.
LISTING_TITLE_LIMIT_SHOPEE=120
LISTING_TITLE_LIMIT_LAZADA=255
LISTING_TITLE_LIMIT_TIKTOK_SHOP=188

# Product Center permissions and optional data scopes. Empty permissions keep the current single-user full-access mode.
PRODUCT_PERMISSIONS=
PRODUCT_ALLOWED_COUNTRIES=
PRODUCT_ALLOWED_CATEGORY_L1=
PRODUCT_ALLOWED_CATEGORY_L2=

# Approved price-control source. Use a dedicated read-only MySQL account in real environments.
# Credentials stay in the environment and are never stored in Commerce Ops tables.
PRICE_CONTROL_MYSQL_HOST=
PRICE_CONTROL_MYSQL_PORT=3306
PRICE_CONTROL_MYSQL_DATABASE=
PRICE_CONTROL_MYSQL_USER=
PRICE_CONTROL_MYSQL_PASSWORD=
PRICE_CONTROL_MYSQL_CONNECTION_LIMIT=2
PRICE_CONTROL_MYSQL_CONNECT_TIMEOUT_MS=10000
PRICE_CONTROL_MYSQL_QUERY_TIMEOUT_MS=120000
# Manual synchronization can be enabled after migration 023 and a reviewed baseline.
PRICE_CONTROL_MANUAL_SYNC_ENABLED=false
PRICE_CONTROL_SYNC_ENABLED=false
PRICE_CONTROL_SYNC_INTERVAL_MS=3600000
PRICE_CONTROL_STALE_RUN_TIMEOUT_MS=1800000
PRICE_CONTROL_BATCH_LIMIT=200
PRICE_CONTROL_BATCHES_PER_COUNTRY=1

# Daily product-package snapshot from AI_Project_A.product_package. When the
# PRODUCT_PACKAGE_MYSQL_* values are empty, the PRICE_CONTROL_MYSQL_* connection
# above is reused. The source connection is always opened read-only.
PRODUCT_PACKAGE_MYSQL_HOST=
PRODUCT_PACKAGE_MYSQL_PORT=3306
PRODUCT_PACKAGE_MYSQL_DATABASE=
PRODUCT_PACKAGE_MYSQL_USER=
PRODUCT_PACKAGE_MYSQL_PASSWORD=
PRODUCT_PACKAGE_MYSQL_CONNECTION_LIMIT=2
PRODUCT_PACKAGE_MYSQL_CONNECT_TIMEOUT_MS=10000
PRODUCT_PACKAGE_SYNC_ENABLED=false
PRODUCT_PACKAGE_MANUAL_SYNC_ENABLED=true
PRODUCT_PACKAGE_SYNC_BATCH_SIZE=2000
PRODUCT_PACKAGE_MAX_REMOVAL_RATIO=0.20
APP_ROOT=
DATA_ROOT=storage
DATABASE_PROVIDER=sqlite
DATABASE_PATH=storage/commerce-ops.sqlite
PYTHON_EXECUTABLE=
PYTHON_VENV_DIR=.venv
MABANG_WORKER_PATH=scripts/mabang_worker.py
MABANG_IMAGE_MAX_SKUS_PER_BATCH=100
MABANG_IMAGE_FULL_SYNC_SEGMENT_SKUS=500
MABANG_IMAGE_DOWNLOAD_CONCURRENCY=8
# Mabang online listing and WPS integration. The managed service stays on loopback.
MABANG_LISTING_SERVICE_MODE=managed
MABANG_LISTING_SERVICE_DIR=integrations/mabang-getdata
MABANG_LISTING_STORAGE_ROOT=storage/integrations/mabang-listing
MABANG_LISTING_HOST=127.0.0.1
MABANG_LISTING_PORT=8877
MABANG_LISTING_BASE_URL=http://127.0.0.1:8877
MABANG_LISTING_INTERNAL_TOKEN=
MABANG_LISTING_INTERNAL_TOKEN_FILE=storage/.mabang-listing-internal-token
CHROME_EXECUTABLE=
CHROME_DEBUG_PORT=9222

# Comma-separated exact domains. Entries extend the built-in platform/CDN lists.
# Wildcards, IP addresses, bare TLDs and URLs are rejected at startup.
CHROME_ALLOWED_HOSTS=
IMAGE_PROXY_ALLOWED_HOSTS=
NETWORK_REQUEST_TIMEOUT_MS=20000
CHROME_MAX_REDIRECTS=5
IMAGE_PROXY_MAX_BYTES=10485760
IMAGE_PROXY_MAX_REDIRECTS=3

# Advertising service remains internal. AD_ANALYZER_PORT is retained as a legacy fallback.
AD_SERVICE_MODE=managed
AD_SERVICE_DIR=../lazada-ads/webapp
AD_SERVICE_HOST=127.0.0.1
AD_SERVICE_PORT=4173
AD_SERVICE_BASE_URL=http://127.0.0.1:4173
AD_SERVICE_INTERNAL_TOKEN=
AD_SERVICE_INTERNAL_TOKEN_FILE=storage/.ad-service-internal-token
AD_ANALYZER_DIR=
AD_ANALYZER_PORT=4173

# Generate a strong random value and keep it outside Git. Do not reuse the access token.
APP_ENCRYPTION_KEY=

# File storage. Keep STORAGE_ROOT, UPLOAD_ROOT, EXPORT_ROOT and TEMP_ROOT on the same filesystem
# so successful temporary files can be moved atomically. EXPORT_STORAGE_PATH remains a fallback.
STORAGE_ROOT=storage
UPLOAD_ROOT=storage/uploads
EXPORT_ROOT=storage/exports/mabang
TEMP_ROOT=storage/temp
FILE_RETENTION_MANUAL_DAYS=30
FILE_RETENTION_SCHEDULED_DAYS=90
FILE_RETENTION_AD_SOURCE_DAYS=30
FILE_RETENTION_AD_OUTPUT_DAYS=90
FILE_RETENTION_REPORT_DAYS=90
FILE_RETENTION_FAILED_TEMP_HOURS=24
FILE_LIFECYCLE_RECENT_MINUTES=10
FILE_LIFECYCLE_MAX_FILES=10000
FILE_LIFECYCLE_TIMEOUT_SECONDS=60
FILE_LIFECYCLE_LEGACY_CUTOFF=2026-07-16T00:00:00+08:00
# Quarantine stays under STORAGE_ROOT. Permanent deletion is intentionally unavailable.
FILE_QUARANTINE_ROOT=quarantine
FILE_QUARANTINE_RETENTION_DAYS=30
FILE_DELETION_ENABLED=false
# Optional controlled advertising scan roots, resolved from AD_SERVICE_DIR by default.
AD_LIFECYCLE_STORAGE_ROOT=
AD_LIFECYCLE_UPLOAD_ROOT=
AD_LIFECYCLE_TEMP_ROOT=
AD_LIFECYCLE_OUTPUT_ROOT=
MAX_UPLOAD_BYTES=20971520
TEMP_FILE_RETENTION_HOURS=24
MAX_WORKBOOK_SHEETS=50
MAX_WORKBOOK_ROWS=200000
MAX_WORKBOOK_COLUMNS=256
PRODUCT_IMPORT_MAX_ROWS=200000
PRODUCT_IMPORT_PARSE_TIMEOUT_MS=600000
PRODUCT_IMAGE_MAX_BYTES=10485760
MAX_XLSX_ENTRIES=2000
MAX_XLSX_ENTRY_BYTES=67108864
MAX_XLSX_UNCOMPRESSED_BYTES=209715200
MAX_XLSX_COMPRESSION_RATIO=200
EXPORT_STORAGE_PATH=storage/exports/mabang

# Set only when this address is reachable from DingTalk clients.
APP_BASE_URL=

SCHEDULER_DB_PATH=storage/commerce-ops.sqlite
SCHEDULER_POLL_INTERVAL_MS=10000
SCHEDULER_CATCH_UP_THRESHOLD_MS=7200000
SCHEDULER_RETRY_DELAYS_MS=30000,120000,300000

# Standalone Mabang fulfillment API. Real order writes stay disabled until a
# designated test order has passed channel selection, waybill and status checks.
FULFILLMENT_HOST=127.0.0.1
FULFILLMENT_PORT=3112
FULFILLMENT_API_TOKEN=
FULFILLMENT_DB_PATH=storage/mabang-fulfillment.sqlite
FULFILLMENT_SHOP_CONFIG_PATH=config/fulfillment-shops.json
FULFILLMENT_MABANG_USERNAME=
FULFILLMENT_MABANG_PASSWORD=
FULFILLMENT_LOOKBACK_DAYS=3
FULFILLMENT_MAX_BATCH_SIZE=10
FULFILLMENT_PREVIEW_TTL_SECONDS=600
FULFILLMENT_VERIFY_TIMEOUT_SECONDS=90
FULFILLMENT_TRACKING_RECOVERY_CHECK_SECONDS=300
FULFILLMENT_TRACKING_RECOVERY_RESET_MINUTES=30
FULFILLMENT_TRACKING_RECOVERY_DEADLINE_HOURS=24
FULFILLMENT_TRACKING_RECOVERY_RESET_ENABLED=false
FULFILLMENT_REAL_SUBMIT_ENABLED=false
FULFILLMENT_SCHEDULER_ENABLED=false
FULFILLMENT_SCHEDULER_INTERVAL_SECONDS=300
FULFILLMENT_WINDOWS_NOTIFICATIONS_ENABLED=false
# Read-only conversational agent. It can inspect, preview and preflight, but has no submit or recovery tools.
FULFILLMENT_AGENT_ENABLED=true
FULFILLMENT_AGENT_MODEL=deepseek-chat
FULFILLMENT_AGENT_MAX_STEPS=6

# PostgreSQL F1 preparation. SQLite remains the active business provider until a later approved stage.
# Put real passwords only in the Git-ignored .env.postgres.local file.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=commerce_ops
POSTGRES_TEST_DATABASE=commerce_ops_migration_test
POSTGRES_SCHEMA=app
POSTGRES_APP_USER=commerce_app
POSTGRES_APP_PASSWORD=
POSTGRES_MIGRATOR_USER=commerce_migrator
POSTGRES_MIGRATOR_PASSWORD=
POSTGRES_SSL=false
POSTGRES_POOL_MAX=5
POSTGRES_POOL_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECTION_TIMEOUT_MS=10000
POSTGRES_STATEMENT_TIMEOUT_MS=30000
# Explicit write gate for SQLite -> commerce_ops_shadow synchronization only.
# Keep false in normal application and scheduler processes.
POSTGRES_SHADOW_SYNC_ENABLED=false
# Optional one-run reuse of a completed snapshot under tmp/postgresql-incremental-sync.
POSTGRES_INCREMENTAL_SOURCE_SNAPSHOT=

# Lazada Open Platform OAuth. Put real credentials only in the Git-ignored .env.
LAZADA_OAUTH_HOST=127.0.0.1
LAZADA_OAUTH_PORT=8977
# Three app slots cover the current 60-store / 20-store-per-app setup.
LAZADA_APP_COUNT=3
LAZADA_DEFAULT_APP_ID=app-1
# App 1 keeps the legacy variables and /lazada/callback route for compatibility.
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
LAZADA_CALLBACK_URL=https://oauth.example.com/lazada/callback
LAZADA_CALLBACK_BASE_URL=https://oauth.example.com
LAZADA_APP_1_ID=app-1
LAZADA_APP_1_NAME=Lazada Stores 01-20
LAZADA_APP_1_CALLBACK_URL=https://oauth.example.com/lazada/callback
LAZADA_APP_2_ID=app-2
LAZADA_APP_2_NAME=Lazada Stores 21-40
LAZADA_APP_2_KEY=
LAZADA_APP_2_SECRET=
LAZADA_APP_2_CALLBACK_URL=https://oauth.example.com/lazada/apps/app-2/callback
LAZADA_APP_3_ID=app-3
LAZADA_APP_3_NAME=Lazada Stores 41-60
LAZADA_APP_3_KEY=
LAZADA_APP_3_SECRET=
LAZADA_APP_3_CALLBACK_URL=https://oauth.example.com/lazada/apps/app-3/callback
LAZADA_AUTH_BASE_URL=https://auth.lazada.com
LAZADA_API_BASE_URL=https://auth.lazada.com/rest
LAZADA_OAUTH_DB_PATH=storage/lazada-oauth.sqlite
LAZADA_OAUTH_STATE_TTL_SECONDS=900
LAZADA_API_TIMEOUT_MS=20000
# Generated automatically on first startup; do not share or rotate without re-encrypting SQLite tokens.
LAZADA_TOKEN_ENCRYPTION_KEY=
# Commerce Platform Connector control plane. By default it reuses the OAuth SQLite file
# and LAZADA_TOKEN_ENCRYPTION_KEY so existing encrypted authorizations migrate without plaintext copies.
COMMERCE_CONNECTOR_DB_PATH=storage/lazada-oauth.sqlite
# Optional future master key. Leave empty while legacy Lazada tokens use the key above.
COMMERCE_CONNECTOR_ENCRYPTION_KEY=
COMMERCE_PLATFORM_REFRESH_SKEW_SECONDS=300
COMMERCE_PLATFORM_READ_RETRIES=2
# Fail closed: product and inventory mutations remain unavailable until explicitly enabled.
COMMERCE_PLATFORM_WRITES_ENABLED=false
# Temporary Profit/Expense/GMV transaction-date ceiling. Leave blank when the
# Mabang GMV scheduler is active and current source-day coverage is available.
PROFIT_TRANSACTION_CUTOFF_DATE=
# Internal Shopee token broker. Keep the real API key only in the Git-ignored .env.
SHOPEE_TOKEN_SERVICE_BASE_URL=
SHOPEE_TOKEN_SERVICE_API_KEY=
SHOPEE_TOKEN_SERVICE_TIMEOUT_MS=20000
# Legacy aliases point to the most recently authorized App 1 store.
LAZADA_SHOP_ID=
LAZADA_ACCESS_TOKEN=
LAZADA_REFRESH_TOKEN=
LAZADA_TOKEN_EXPIRE_TIME=
# Every successful authorization also writes a per-store mirror such as:
# LAZADA_STORE_APP_2_TH1ABC_ACCESS_TOKEN=...

# Stable named Cloudflare Tunnel. The token is loaded from .env, never source code.
CLOUDFLARE_TUNNEL_MODE=quick
CLOUDFLARE_QUICK_TUNNEL_URL=
CLOUDFLARE_TUNNEL_NAME=commerce-ops-lazada-oauth
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_HOSTNAME=
CLOUDFLARE_TUNNEL_TOKEN=
