# Commerce Ops application. Keep loopback defaults for local-only access.
APP_HOST=127.0.0.1
APP_PORT=3101
APP_ACCESS_TOKEN=
# Explicitly opt in to LAN access without a login key. Keep false for safer deployments.
APP_ALLOW_UNAUTHENTICATED_LAN=false

# Audit logging. TRUST_PROXY accepts exact proxy IP addresses separated by commas.
# Leave TRUST_PROXY empty unless the application is actually behind those trusted proxies.
TRUST_PROXY=
AUDIT_RETENTION_DAYS=180

# Legacy names remain during the node B compatibility transition.
HOST=127.0.0.1
PORT=3101

DEEPSEEK_API_KEY=
# Optional DeepSeek-compatible endpoint. A bare base URL receives /chat/completions automatically.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4

# Image generation is a separate provider from DeepSeek. DeepSeek only creates image plans/prompts.
# Leave these blank to keep prompt-only mode. Never expose these values to the browser.
IMAGE_AI_PROVIDER=
IMAGE_AI_API_KEY=
IMAGE_AI_BASE_URL=
IMAGE_AI_MODEL=
# Optional JSON override for the default 1 primary + 6 secondary image template.
IMAGE_AI_TEMPLATE_JSON=

# Configurable listing title limits. Values are guidance until live platform rules are connected.
LISTING_TITLE_LIMIT_SHOPEE=120
LISTING_TITLE_LIMIT_LAZADA=255
LISTING_TITLE_LIMIT_TIKTOK_SHOP=188

# Product Center permissions and optional data scopes. Empty permissions keep the current single-user full-access mode.
PRODUCT_PERMISSIONS=
PRODUCT_ALLOWED_COUNTRIES=
PRODUCT_ALLOWED_CATEGORY_L1=
PRODUCT_ALLOWED_CATEGORY_L2=
APP_ROOT=
DATA_ROOT=storage
DATABASE_PROVIDER=sqlite
DATABASE_PATH=storage/commerce-ops.sqlite
PYTHON_EXECUTABLE=
PYTHON_VENV_DIR=.venv
MABANG_WORKER_PATH=scripts/mabang_worker.py
MABANG_IMAGE_MAX_SKUS_PER_BATCH=100
CHROME_EXECUTABLE=
CHROME_DEBUG_PORT=9222

# Comma-separated exact domains. Entries extend the built-in platform/CDN lists.
# Wildcards, IP addresses, bare TLDs and URLs are rejected at startup.
CHROME_ALLOWED_HOSTS=
IMAGE_PROXY_ALLOWED_HOSTS=
NETWORK_REQUEST_TIMEOUT_MS=20000
CHROME_MAX_REDIRECTS=5
IMAGE_PROXY_MAX_BYTES=10485760
IMAGE_PROXY_MAX_REDIRECTS=3

# Advertising service remains internal. AD_ANALYZER_PORT is retained as a legacy fallback.
AD_SERVICE_MODE=managed
AD_SERVICE_DIR=../lazada-ads/webapp
AD_SERVICE_HOST=127.0.0.1
AD_SERVICE_PORT=4173
AD_SERVICE_BASE_URL=http://127.0.0.1:4173
AD_SERVICE_INTERNAL_TOKEN=
AD_SERVICE_INTERNAL_TOKEN_FILE=storage/.ad-service-internal-token
AD_ANALYZER_DIR=
AD_ANALYZER_PORT=4173

# Generate a strong random value and keep it outside Git. Do not reuse the access token.
APP_ENCRYPTION_KEY=

# File storage. Keep STORAGE_ROOT, UPLOAD_ROOT, EXPORT_ROOT and TEMP_ROOT on the same filesystem
# so successful temporary files can be moved atomically. EXPORT_STORAGE_PATH remains a fallback.
STORAGE_ROOT=storage
UPLOAD_ROOT=storage/uploads
EXPORT_ROOT=storage/exports/mabang
TEMP_ROOT=storage/temp
FILE_RETENTION_MANUAL_DAYS=30
FILE_RETENTION_SCHEDULED_DAYS=90
FILE_RETENTION_AD_SOURCE_DAYS=30
FILE_RETENTION_AD_OUTPUT_DAYS=90
FILE_RETENTION_REPORT_DAYS=90
FILE_RETENTION_FAILED_TEMP_HOURS=24
FILE_LIFECYCLE_RECENT_MINUTES=10
FILE_LIFECYCLE_MAX_FILES=10000
FILE_LIFECYCLE_TIMEOUT_SECONDS=60
FILE_LIFECYCLE_LEGACY_CUTOFF=2026-07-16T00:00:00+08:00
# Quarantine stays under STORAGE_ROOT. Permanent deletion is intentionally unavailable.
FILE_QUARANTINE_ROOT=quarantine
FILE_QUARANTINE_RETENTION_DAYS=30
FILE_DELETION_ENABLED=false
# Optional controlled advertising scan roots, resolved from AD_SERVICE_DIR by default.
AD_LIFECYCLE_STORAGE_ROOT=
AD_LIFECYCLE_UPLOAD_ROOT=
AD_LIFECYCLE_TEMP_ROOT=
AD_LIFECYCLE_OUTPUT_ROOT=
MAX_UPLOAD_BYTES=20971520
TEMP_FILE_RETENTION_HOURS=24
MAX_WORKBOOK_SHEETS=50
MAX_WORKBOOK_ROWS=200000
MAX_WORKBOOK_COLUMNS=256
PRODUCT_IMPORT_MAX_ROWS=200000
PRODUCT_IMPORT_PARSE_TIMEOUT_MS=600000
PRODUCT_IMAGE_MAX_BYTES=10485760
MAX_XLSX_ENTRIES=2000
MAX_XLSX_ENTRY_BYTES=67108864
MAX_XLSX_UNCOMPRESSED_BYTES=209715200
MAX_XLSX_COMPRESSION_RATIO=200
EXPORT_STORAGE_PATH=storage/exports/mabang

# Set only when this address is reachable from DingTalk clients.
APP_BASE_URL=

SCHEDULER_DB_PATH=storage/commerce-ops.sqlite
SCHEDULER_POLL_INTERVAL_MS=10000
SCHEDULER_CATCH_UP_THRESHOLD_MS=7200000
SCHEDULER_RETRY_DELAYS_MS=30000,120000,300000

# Standalone Mabang fulfillment API. Real order writes stay disabled until a
# designated test order has passed channel selection, waybill and status checks.
FULFILLMENT_HOST=127.0.0.1
FULFILLMENT_PORT=3112
FULFILLMENT_API_TOKEN=
FULFILLMENT_DB_PATH=storage/mabang-fulfillment.sqlite
FULFILLMENT_SHOP_CONFIG_PATH=config/fulfillment-shops.json
FULFILLMENT_MABANG_USERNAME=
FULFILLMENT_MABANG_PASSWORD=
FULFILLMENT_LOOKBACK_DAYS=3
FULFILLMENT_MAX_BATCH_SIZE=10
FULFILLMENT_PREVIEW_TTL_SECONDS=600
FULFILLMENT_VERIFY_TIMEOUT_SECONDS=90
FULFILLMENT_TRACKING_RECOVERY_CHECK_SECONDS=300
FULFILLMENT_TRACKING_RECOVERY_RESET_MINUTES=30
FULFILLMENT_TRACKING_RECOVERY_DEADLINE_HOURS=24
FULFILLMENT_TRACKING_RECOVERY_RESET_ENABLED=false
FULFILLMENT_REAL_SUBMIT_ENABLED=false
FULFILLMENT_SCHEDULER_ENABLED=false
FULFILLMENT_SCHEDULER_INTERVAL_SECONDS=300
FULFILLMENT_WINDOWS_NOTIFICATIONS_ENABLED=false

# PostgreSQL F1 preparation. SQLite remains the active business provider until a later approved stage.
# Put real passwords only in the Git-ignored .env.postgres.local file.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=commerce_ops
POSTGRES_TEST_DATABASE=commerce_ops_migration_test
POSTGRES_SCHEMA=app
POSTGRES_APP_USER=commerce_app
POSTGRES_APP_PASSWORD=
POSTGRES_MIGRATOR_USER=commerce_migrator
POSTGRES_MIGRATOR_PASSWORD=
POSTGRES_SSL=false
POSTGRES_POOL_MAX=5
POSTGRES_POOL_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECTION_TIMEOUT_MS=10000
POSTGRES_STATEMENT_TIMEOUT_MS=30000
