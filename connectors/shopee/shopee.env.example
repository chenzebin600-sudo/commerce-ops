# Store real values only in an ignored local environment file or secret manager.
SHOPEE_RELAY_BASE_URL=http://internal-shopee-relay.example:8788
SHOPEE_RELAY_API_KEY=
SHOPEE_RELAY_TIMEOUT_MS=20000
SHOPEE_MODEL_REQUEST_CONCURRENCY=4

# Shared connector control plane. Generate a unique 32-byte base64url key.
COMMERCE_CONNECTOR_ENCRYPTION_KEY=
COMMERCE_CONNECTOR_DB_PATH=storage/lazada-oauth.sqlite

# Writes remain globally disabled by default. Shopee does not register writes.
COMMERCE_PLATFORM_WRITES_ENABLED=false
COMMERCE_PLATFORM_READ_RETRIES=1
