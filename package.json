{
  "name": "lazada-competitor-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run start:all",
    "dev": "node --disable-warning=ExperimentalWarning scripts/start-dev.mjs",
    "start:main": "node --disable-warning=ExperimentalWarning server.mjs",
    "dev:main": "node --disable-warning=ExperimentalWarning --watch --watch-preserve-output server.mjs",
    "start:scheduler": "node --disable-warning=ExperimentalWarning scheduler.mjs",
    "start:fulfillment": "node --disable-warning=ExperimentalWarning fulfillment-service/server.mjs",
    "dev:fulfillment": "node --disable-warning=ExperimentalWarning --watch --watch-preserve-output fulfillment-service/server.mjs",
    "start:fulfillment:supervised": "node --disable-warning=ExperimentalWarning scripts/fulfillment-supervisor.mjs",
    "start:system": "node --disable-warning=ExperimentalWarning scripts/system-supervisor.mjs",
    "start:ads": "node scripts/start-ads.mjs",
    "start:mabang-listing": "node scripts/start-mabang-listing.mjs",
    "start:mabang-wps": "node scripts/start-mabang-wps.mjs",
    "scheduler": "npm run start:scheduler",
    "start:core": "node scripts/start-all.mjs",
    "start:all": "node --disable-warning=ExperimentalWarning scripts/system-supervisor.mjs",
    "dev:growth-radar:g1b": "node --disable-warning=ExperimentalWarning scripts/start-growth-radar-g1b.mjs",
    "doctor": "node --disable-warning=ExperimentalWarning scripts/doctor.mjs",
    "doctor:growth-radar:g1b": "node --disable-warning=ExperimentalWarning scripts/doctor-growth-radar-g1b.mjs",
    "check:paths": "node scripts/check-portable-paths.mjs",
    "migrate": "node --disable-warning=ExperimentalWarning scripts/migrate.mjs",
    "audit:cleanup": "node --disable-warning=ExperimentalWarning scripts/cleanup-audit.mjs",
    "postgres:readiness": "node --disable-warning=ExperimentalWarning scripts/postgresql-readiness.mjs",
    "postgres:f1:protect": "node --disable-warning=ExperimentalWarning scripts/postgresql-f1-protect.mjs",
    "postgres:f1:init": "node --disable-warning=ExperimentalWarning scripts/postgresql-f1-init.mjs",
    "postgres:f1:check": "node --disable-warning=ExperimentalWarning scripts/postgresql-f1-check.mjs",
    "postgres:f2:check": "node --disable-warning=ExperimentalWarning scripts/postgresql-f2-provider-check.mjs",
    "postgres:f3:migrate-test": "node --disable-warning=ExperimentalWarning scripts/postgresql-f3-migration-test.mjs",
    "postgres:f4:check": "node --disable-warning=ExperimentalWarning scripts/postgresql-f4-compatibility-check.mjs",
    "validate:growth-radar:g1a5": "node --disable-warning=ExperimentalWarning scripts/validate-growth-radar-g1a5.mjs",
    "build:growth-radar:v2": "npm --prefix frontend/growth-radar-v2 run build",
    "build:sales-assortment": "npm --prefix frontend/sales-assortment-dashboard run build",
    "build:mabang-listing": "npm --prefix frontend/mabang-listing run build",
    "build": "npm run check:paths && npm run build:growth-radar:v2 && npm run build:sales-assortment && npm run build:mabang-listing && node scripts/check-build.mjs",
    "test:mabang-getdata": "node scripts/test-mabang-getdata.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.mjs"
  },
  "dependencies": {
    "pg": "8.22.0"
  }
}
